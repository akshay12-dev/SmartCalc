<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security config: explicitly trust HTTPS for currency rate APIs.
    Cleartext (HTTP) traffic is disallowed except for localhost (debug only).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">open.er-api.com</domain>
        <domain includeSubdomains="true">api.exchangerate-api.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
